#!/usr/bin/env bash
# AutoRailBridges — environment variables.
#
# Machine-level shared values (UNITY_BIN, SDK_PATH, CK_GAME_VERSION,
# MODIO_DEPS_MAP, LOC_TABLE, the ilspycmd PATH entry) are inherited from the
# parent core_keeper/.envrc — define them once there, not here.
#
#   cp .envrc.example .envrc
#   direnv allow                     # then `cd` triggers the chain
#   # or, without direnv:  source .envrc && ../utils/build.sh

# --- Inherit shared values from the parent core_keeper/.envrc ---------------
if command -v source_up_if_exists >/dev/null 2>&1; then
    source_up_if_exists          # direnv: walk up to core_keeper/.envrc
elif [ -f ../.envrc ]; then
    source ../.envrc             # manual `source .envrc` fallback
fi

# --- Mod identity (project-inherent — leave as-is) --------------------------

# PascalCase name — drives SDK symlink paths and the build entry point.
export MOD_NAME="AutoRailBridges"

# kebab-case id, written as `name_id` in the fake mod.io state.json.
export MOD_NAME_ID="auto-rail-bridges"

# One-line summary, written into state.json by utils/install-macos.sh.
export MOD_SUMMARY="Placing a rail where it cannot go lays a bridge from your inventory underneath it first."

# Fake mod.io ID — must be DISTINCT per mod.
export FAKE_MOD_ID="9999988"

# Repo root, read by the shared CLIPublishHelper to locate CHANGELOG.md.
export MOD_REPO_ROOT="$PWD"

# mod.io "Type" tags for the listing — PIPE-separated, because the values
# contain spaces. Synchronised (not just added) by the shared
# CLIPublishHelper, so a value dropped here is removed on mod.io. Valid:
# Visual, Audio, Item, NPC, Quality of Life, Overhaul, Language, World,
# Library, Other.
export CK_MODIO_TYPE="Quality of Life|World"

# Forum tags for this mod's thread in the Core Keeper Discord's
# #available-mods channel — PIPE-separated, because "Misc / Other" contains
# spaces. Read by utils/discord_post.py; Discord allows at most five.
export CK_DISCORD_TAGS="Transportation|Automation|Utilities"
# This mod's existing thread in #available-mods. Empty means no thread yet, so
# a new post is created; set means a new version is announced as a comment.
# Filled in from the posted thread's URL, not by hand.
export CK_DISCORD_THREAD="https://discord.com/channels/851842678340845600/1083718088526139443/threads/1542686961117036665"


# Images and clips for the post, beyond the logo — PIPE-separated, in the order
# they should appear. A relative path becomes an attachment, an http(s) URL
# becomes its own follow-up message (the only route for a clip past Discord's
# upload ceiling). Empty is legitimate here, unlike CK_DISCORD_TAGS: it means
# the mod has nothing to show beyond its logo.
# URLs rather than paths: these clips are 35 and 38 MB, far past what can be
# attached, and Discord embeds an external media URL regardless of size. The
# post's own wording ('the clips below') depends on them arriving this way.
export CK_DISCORD_MEDIA="https://raw.githubusercontent.com/Valgard/ck_auto_rail_bridges/main/sources/ck_auto_rail_bridges_wood.gif|https://raw.githubusercontent.com/Valgard/ck_auto_rail_bridges/main/sources/ck_auto_rail_bridges_stone.gif"

# --- Localisation (read by utils/CLIBuildHelper.cs -> LocalizationGenerator.GenerateFromEnv) ---
# LOC_TABLE (the shared CK language-address table) is inherited from the parent core_keeper/.envrc.
export LOC_YAML="$PWD/localization/localization.yaml"
export LOC_OUT="$PWD/unity/$MOD_NAME/Localization/Generated"
